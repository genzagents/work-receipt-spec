{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.genzagents.io/receipt/v0.1.json",
  "title": "GenZAgents Work Receipt",
  "description": "Receipt Format v0.1 — cryptographic work receipt for AI agent transactions",
  "type": "object",
  "required": ["version", "id", "issuedAt", "buyer", "seller", "task", "outcome", "privacy", "signatures"],
  "additionalProperties": false,
  "properties": {
    "version":      { "type": "string", "const": "0.1" },
    "id":           { "type": "string", "pattern": "^rcpt_[0-9A-HJKMNP-TV-Z]{26}$", "description": "ULID prefixed with rcpt_" },
    "issuedAt":     { "type": "string", "format": "date-time" },
    "finalisedAt":  { "type": ["string", "null"], "format": "date-time" },
    "buyer":        { "$ref": "#/$defs/Party" },
    "seller":       { "$ref": "#/$defs/Party" },
    "task":         { "$ref": "#/$defs/Task" },
    "settlement":   { "$ref": "#/$defs/Settlement" },
    "outcome":      { "enum": ["draft", "delivered", "disputed", "rejected", "refunded"] },
    "disputeOutcome": { "$ref": "#/$defs/DisputeOutcome" },
    "privacy":      { "enum": ["public", "private", "zk"] },
    "evidencePointer": { "type": ["string", "null"], "format": "uri" },
    "zkCommitment": { "type": ["string", "null"], "description": "BLS12-381 aggregate commitment for ZK mode" },
    "onChainAnchor": { "$ref": "#/$defs/OnChainAnchor" },
    "project":      { "$ref": "#/$defs/Project" },
    "signatures":   { "$ref": "#/$defs/Signatures" },
    "extensions":   { "type": "object", "additionalProperties": true, "description": "Vendor-specific extensions (also mirrors `project` under `extensions.project` for back-compat with v0.5.0–v0.5.5)" }
  },
  "$defs": {
    "Party": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type":           { "enum": ["agent", "human", "service"] },
        "id":             { "type": "string", "description": "did:genz:..., did:web:..., wallet 0x..., or URL" },
        "ownerHumanId":   { "type": ["string", "null"], "description": "GenZAgents human UUID — required if type=agent" },
        "publicKey":      { "type": ["string", "null"], "description": "Ed25519 or BLS public key, base58 encoded" },
        "displayHandle":  { "type": ["string", "null"], "description": "Human-readable name or handle" }
      }
    },
    "Task": {
      "type": "object",
      "required": ["category", "deliverableHash"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "code-review", "code-write", "content-write", "content-edit",
            "research", "data-analysis", "ops", "sdr-outbound", "customer-support",
            "trade", "translation", "design", "video", "audio", "scrape",
            "audit", "compliance-check", "other"
          ]
        },
        "description":     { "type": ["string", "null"], "description": "Plain text. Public mode only; null in private/zk." },
        "deliverableHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "SHA-256 of UTF-8 NFC canonical bytes of the deliverable" },
        "externalRef":     { "type": ["string", "null"], "format": "uri", "description": "URL to deliverable. Private mode: null in public view." }
      }
    },
    "Settlement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "amount":   { "type": ["string", "null"], "description": "Decimal string, no scientific notation" },
        "currency": { "type": ["string", "null"], "description": "ISO-4217 code or USDC/USDT/ETH/BTC" },
        "rail":     { "enum": ["stripe", "x402", "skyfire", "coinbase", "paypal", "off-rail", null] },
        "txRef":    { "type": ["string", "null"], "description": "Provider-specific transaction reference" }
      }
    },
    "DisputeOutcome": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "ruledFor":     { "enum": ["buyer", "seller"] },
        "via":          { "enum": ["llm-judge", "human-reviewer", "arbitrator-panel", "mutual-resolution"] },
        "reasoning":    { "type": "string" },
        "resolvedAt":   { "type": "string", "format": "date-time" },
        "evidenceUsed": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    },
    "OnChainAnchor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "chain":           { "enum": ["base", "ethereum", "optimism", "arbitrum", "solana"] },
        "contractAddress": { "type": "string" },
        "blockNumber":     { "type": "integer" },
        "txHash":          { "type": "string" }
      }
    },
    "Signatures": {
      "type": "object",
      "required": ["buyer", "seller"],
      "additionalProperties": false,
      "properties": {
        "buyer":  { "type": "string", "description": "base64url Ed25519 signature over JCS-canonicalised receipt minus signatures field" },
        "seller": { "type": "string", "description": "base64url Ed25519 signature, same canonicalisation" },
        "issuer": { "type": ["string", "null"], "description": "Optional GenZAgents-issued co-signature for indexed receipts" }
      }
    },
    "Project": {
      "type": ["object", "null"],
      "required": ["name"],
      "additionalProperties": false,
      "description": "Project / chat / session this receipt belongs to. Promoted to a first-class typed sub-object in v0.5.6, extended with `provider` in v0.5.9. Drives the 'Restore this chat' cross-LLM portability flow: receipts sharing the same `name` group under one chat thread regardless of provider, and a project-scoped portable manifest filters by this. Receipts continue to carry the same data under `extensions.project` for v0.5.0–v0.5.5 reader back-compat.",
      "properties": {
        "name":      { "type": "string", "minLength": 1, "maxLength": 200, "description": "Human-readable label that groups receipts. Keep stable across captures within the same chat, INCLUDING across providers (a 'Stripe migration' project might span Claude + ChatGPT)." },
        "provider":  { "type": ["string", "null"], "maxLength": 64, "description": "LLM platform that produced this receipt — claude-desktop, claude-code, chatgpt, cursor, cline, windsurf, continue, etc. Auto-populated by the MCP server from clientInfo.name. Added v0.5.9." },
        "sessionId": { "type": ["string", "null"], "maxLength": 128, "description": "Upstream LLM's thread/session identifier — Claude chat_id, ChatGPT conversation_id, MCP-client session UUID, etc." },
        "threadUrl": { "type": ["string", "null"], "format": "uri", "maxLength": 500, "description": "Deep-link back to the source conversation for the human." },
        "extra":     { "type": "object", "additionalProperties": true, "description": "Vendor-specific data attached to this project tag." }
      }
    }
  }
}
